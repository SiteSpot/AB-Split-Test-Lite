{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": {
    "title": "AB Split Test Lite demo",
    "author": "tomcarless",
    "description": "Try self-hosted A/B testing: sample tests with results, heatmaps, and the point-and-click Magic Bar."
  },
  "landingPage": "/wp-admin/edit.php?post_type=bt_experiments",
  "preferredVersions": { "php": "8.3", "wp": "latest" },
  "features": { "networking": false },
  "steps": [
    { "step": "login", "username": "admin", "password": "password" },
    {
      "step": "setSiteOptions",
      "options": {
        "blogname": "AB Split Test demo",
        "blogdescription": "Self-hosted A/B testing, running right here",
        "permalink_structure": "/%postname%/"
      }
    },
    {
      "step": "installPlugin",
      "pluginData": { "resource": "wordpress.org/plugins", "slug": "ab-split-test-lite" },
      "options": { "activate": true }
    },
    {
      "step": "runPHP",
      "code": "<?php require '/wordpress/wp-load.php'; update_option('abst_enable_heatmaps', 1); update_option('abst_enable_session_replays', 1); update_option('abst_heatmap_all_pages', 'all');"
    }
  ]
}
